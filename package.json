{
  "name": "workisland",
  "productName": "WorkIsland",
  "version": "3.1.0",
  "description": "macOS 本地 Work Agent 工作状态与注意力路由器",
  "private": true,
  "main": "./src/main/index.cjs",
  "author": "WorkIsland contributors",
  "license": "Apache-2.0",
  "keywords": [
    "electron",
    "macos",
    "work-agent",
    "dynamic-island"
  ],
  "scripts": {
    "setup": "npm install && npm run build:assets && npm run build:native",
    "postinstall": "node ./scripts/prepare-node-pty.mjs",
    "build:renderer": "node ./scripts/build-renderer.mjs",
    "build:assets": "node ./scripts/generate-assets.mjs",
    "dev": "npm run build:renderer && node ./scripts/dev.mjs --full",
    "dev:isolated": "npm run build:renderer && node ./scripts/dev.mjs",
    "dev:full": "npm run build:renderer && node ./scripts/dev.mjs --full",
    "start": "npm run dev",
    "setup:electron": "npm install --prefix ./.tools/electron-shell --no-save electron@43.3.0 --cache ./.npm-cache",
    "build:native": "node ./scripts/build-native.mjs",
    "package:mac": "npm run build:assets && npm run build:native && npm run check && electron-builder --mac --arm64 --publish never",
    "release:check": "node ./scripts/release-check.mjs",
    "check": "npm run build:renderer && node ./scripts/check.mjs && node ./scripts/test-source.mjs && npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "smoke:hook": "node ./scripts/smoke-hook.mjs",
    "smoke:hook:isolated": "node ./scripts/smoke-hook.mjs --isolated",
    "smoke:approval:isolated": "node ./scripts/smoke-approval.mjs",
    "smoke:ui": "node ./scripts/smoke-ui.mjs",
    "doctor": "node ./scripts/doctor.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.11.1",
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "@iarna/toml": "2.2.5",
    "@xterm/xterm": "6.0.0",
    "electron-log": "5.4.4",
    "js-yaml": "4.3.1",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "ws": "^8.21.2"
  },
  "build": {
    "appId": "app.workisland.desktop",
    "productName": "WorkIsland",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "resources/bin/panel_fix.node",
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "README.md",
      "SECURITY.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources/sounds",
        "to": "sounds"
      },
      {
        "from": "resources/pet-sprites",
        "to": "pet-sprites"
      },
      {
        "from": "resources/bin/flux-hooks",
        "to": "bin/flux-hooks"
      },
      {
        "from": "resources/mediaremote-adapter",
        "to": "mediaremote-adapter"
      },
      {
        "from": "resources/scripts/collect-logs.sh",
        "to": "scripts/collect-logs.sh"
      },
      {
        "from": "resources/dsh-workisland-bridge",
        "to": "dsh-workisland-bridge"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": [
        "/Resources/.*\\.lproj/",
        "\\.(pak|png|webp|wav|json|icns|dat|bin)$"
      ]
    },
    "dmg": {
      "title": "WorkIsland"
    }
  }
}
